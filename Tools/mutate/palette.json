      "find": "                roles[solo.Key] = Rgb.Parse(solo.Value);",
      "replace": "                if (chosen == null || !chosen.ContainsKey(solo.Key)) roles[solo.Key] = Rgb.Parse(solo.Value);"
    },
    {
      "name": "a delver's own colour is ignored",
      "file": "Assets/GameAssets/Core/Content/HeroPalette.cs",
      "find": "                if (chosen == null || !chosen.TryGetValue(family.Base, out picked))",
      "replace": "                if (true)"
    }
  ]
}
