{
  "name": "the run layer and its rules",
  "mutants": [
    {
      "name": "the breather also heals before floor 1",
      "file": "Assets/GameAssets/Core/Run/DelveRun.cs",
      "find": "if (floor <= 1) return 0;",
      "replace": ""
    },
    {
      "name": "the breather ignores a Second Stomach",
      "file": "Assets/GameAssets/Core/Run/DelveRun.cs",
      "find": "return setup.Breath * (run.Has(RelicId.SecondStomach) ? 2 : 1);",
      "replace": "return setup.Breath;"
    },
    {
      "name": "promised gold arrives a floor early",
      "file": "Assets/GameAssets/Core/Run/DelveRun.cs",
