    },
    {
      "name": "the event stream is the fight stream",
      "file": "Assets/GameAssets/Core/Run/DelveRun.cs",
      "find": "var events = new Mulberry32(seed ^ EventSeedMix);",
      "replace": "var events = new Mulberry32(seed);"
    },
    {
      "name": "the shuffle walks upward",
      "file": "Assets/GameAssets/Core/Run/DelveRun.cs",
